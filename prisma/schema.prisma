// LogPilot — Prisma schema
// ---------------------------------------------------------------------------
// Local development uses SQLite for a zero-config experience. For production,
// switch `provider` to "postgresql" and point DATABASE_URL at Neon / Railway.
//
// Role model (assessment-focused): two user types — DRIVER and FLEET_MANAGER.
// Drivers create/certify their own daily logs; fleet managers review the logs
// of every driver in their carrier.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DRIVER
  FLEET_MANAGER
}

enum LogStatus {
  DRAFT
  CERTIFIED
}

enum DutyStatus {
  OFF
  SB
  D
  ON
}

model Carrier {
  id           String   @id @default(cuid())
  name         String
  mainOffice   String?
  homeTerminal String?
  dotNumber    String?
  createdAt    DateTime @default(now())

  members User[]   @relation("CarrierMembers")
  drivers Driver[]
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(DRIVER)
  carrierId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  carrier Carrier? @relation("CarrierMembers", fields: [carrierId], references: [id])
  driver  Driver?
}

model Driver {
  id            String  @id @default(cuid())
  userId        String  @unique
  licenseNumber String
  licenseState  String
  homeTerminal  String?
  mainOffice    String?
  timezone      String  @default("America/New_York")
  cycle         String  @default("70/8")
  truckNumber   String?
  trailerNumber String?
  signatureData String?
  carrierId     String?

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  carrier Carrier?   @relation(fields: [carrierId], references: [id])
  logs    DailyLog[]
}

model DailyLog {
  id             String    @id @default(cuid())
  driverId       String
  date           String // ISO yyyy-mm-dd (one calendar day)
  driverName     String
  coDriverName   String?
  carrierName    String
  mainOffice     String?
  homeTerminal   String?
  truckNumber    String?
  trailerNumber  String?
  shippingNumber String?
  commodity      String?
  totalMiles     Int       @default(0)
  cycle          String    @default("70/8")
  status         LogStatus @default(DRAFT)
  certified      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  driver       Driver        @relation(fields: [driverId], references: [id], onDelete: Cascade)
  entries      DutyEntry[]
  remarks      Remark[]
  shippingDocs ShippingDoc[]

  @@unique([driverId, date])
  @@index([driverId])
}

model DutyEntry {
  id       String     @id @default(cuid())
  logId    String
  status   DutyStatus
  startMin Int
  endMin   Int
  location String?
  remark   String?
  log      DailyLog   @relation(fields: [logId], references: [id], onDelete: Cascade)

  @@index([logId])
}

model Remark {
  id       String   @id @default(cuid())
  logId    String
  timeMin  Int
  location String
  note     String?
  log      DailyLog @relation(fields: [logId], references: [id], onDelete: Cascade)
}

model ShippingDoc {
  id        String   @id @default(cuid())
  logId     String
  proNumber String?
  shipper   String?
  commodity String?
  log       DailyLog @relation(fields: [logId], references: [id], onDelete: Cascade)
}
